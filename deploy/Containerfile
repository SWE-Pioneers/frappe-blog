# Custom Blog image for SWE-Pioneers demo — v16
# Base: frappe/erpnext:v16.26.2 — Frappe does not publish a standalone "frappe-only"
# image on Docker Hub (only frappe/erpnext), so this is the same proven base as the
# prod erpnext image. blog only needs frappe core; erpnext is baked in but never
# installed on a blog site (--install-app blog only), so it's unused image weight,
# not a functional dependency.
FROM frappe/erpnext:v16.26.2

# yarn is not shipped in the runtime image; add it as a safety net for any app
# that needs its own node_modules installed during `bench build`.
USER root
RUN npm install -g yarn >/dev/null 2>&1 || true

USER frappe
WORKDIR /home/frappe/frappe-bench

# --- Blog (SWE-Pioneers fork, version-16 branch — includes Arabic i18n) ---
RUN bench get-app --branch version-16 blog https://github.com/SWE-Pioneers/frappe-blog

# --- Compile JS/CSS assets for all apps (esbuild) ---
# `bench build` writes its manifest + per-app symlinks to sites/assets/ (no runtime
# symlink exists yet during `docker build`, so it's a plain new directory there) — but
# `sites` is a VOLUME declared by the base image, so anything written under it is
# silently discarded when this RUN's container commits into a layer. The actual bundle
# files land under apps/<app>/<app>/public (not under sites/) and DO persist correctly,
# but the manifest/symlinks would otherwise be lost, leaving the container entrypoint's
# `ln -s assets sites/assets` (at runtime) pointing at a stale, pre-blog manifest.
# Copy the build's real output into the non-volume assets/ path, in the SAME RUN step,
# so it's baked into the image for every container (backend/frontend/websocket/workers)
# started from it.
# `bench build`'s app-symlink step (generate_assets_map -> get_all_apps) reads
# sites/apps.txt to decide which apps to symlink into assets/ — but `blog` only gets
# added to apps.txt at `bench install-app`/site-creation time, not by `get-app`, so at
# build time apps.txt still only lists the base image's frappe+erpnext and `blog` gets
# silently skipped. Seed it correctly first, in the same RUN as the build.
RUN printf 'frappe\nblog\n' > sites/apps.txt \
    && bench build \
    && bench compile-po-to-mo --app frappe --force \
    && bench compile-po-to-mo --app blog --force \
    && rm -rf /home/frappe/frappe-bench/assets \
    && cp -a /home/frappe/frappe-bench/sites/assets /home/frappe/frappe-bench/assets
